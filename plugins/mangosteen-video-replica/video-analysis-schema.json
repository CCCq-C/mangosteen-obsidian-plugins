{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["visualStyle", "character", "products", "scenes", "shots"],
  "properties": {
    "visualStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "prompt"],
      "properties": {
        "category": { "type": "string", "minLength": 2, "maxLength": 32 },
        "prompt": { "type": "string", "minLength": 20 }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "voiceProfile"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "prompt": { "type": "string", "minLength": 20 },
        "voiceProfile": { "type": "string" }
      }
    },
    "products": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "prompt": { "type": "string", "minLength": 20 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "prompt": { "type": "string", "minLength": 20 }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "sceneId", "productIds", "startTime", "endTime", "timeline"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "sceneId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "productIds": {
            "type": "array",
            "maxItems": 2,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
          },
          "startTime": { "type": "number", "minimum": 0 },
          "endTime": { "type": "number", "exclusiveMinimum": 0 },
          "timeline": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "action", "dialogue", "performance", "camera", "environment"],
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 },
                "action": { "type": "string", "minLength": 1 },
                "dialogue": { "type": "string" },
                "performance": { "type": "string" },
                "camera": { "type": "string", "minLength": 1 },
                "environment": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
